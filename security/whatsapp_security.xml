<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_whatsapp" model="ir.module.category">
        <field name="name">WhatsApp</field>
        <field name="description">WhatsApp messaging integration</field>
        <field name="sequence">55</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_whatsapp">
        <field name="name">WhatsApp</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_whatsapp"/>
    </record>

    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="comment">Can send WhatsApp messages and view message logs.</field>
    </record>

    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to WhatsApp settings and message logs.</field>
    </record>

    <!-- Empty group: legacy menu XML IDs stay upgrade-safe but stay hidden from all users. -->
    <record id="group_whatsapp_legacy_nav_hidden" model="res.groups">
        <field name="name">Legacy Navigation (Hidden)</field>
        <field name="sequence">99</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="comment">Do not assign. Keeps deprecated Dashboard / Send Message menuitems out of navigation.</field>
    </record>

    <record id="rule_whatsapp_message_log_company" model="ir.rule">
        <field name="name">WhatsApp Message Log: multi-company</field>
        <field name="model_id" ref="model_whatsapp_message_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_whatsapp_config_company" model="ir.rule">
        <field name="name">WhatsApp Config: multi-company</field>
        <field name="model_id" ref="model_whatsapp_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_whatsapp_bulk_campaign_company" model="ir.rule">
        <field name="name">WhatsApp Bulk Campaign: multi-company</field>
        <field name="model_id" ref="model_whatsapp_bulk_campaign"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
