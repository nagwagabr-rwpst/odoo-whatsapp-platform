<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_send_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.send.wizard.form</field>
        <field name="model">whatsapp.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <sheet>
                    <group>
                        <field name="recipient_number" placeholder="e.g. +1 555 123 4567"/>
                        <field name="message" placeholder="Type your message..."/>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send"
                        string="Send"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"/>
                    <button name="action_cancel"
                        string="Cancel"
                        type="object"
                        class="btn-secondary"
                        data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
